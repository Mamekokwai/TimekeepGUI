**/node_modules/
/.npm/
/.pnpm-store/
/dist/
/dist-ssr/
/dist-codex-smoke/
/artifacts/
/tmp/
/.tmp/
*.tsbuildinfo

# Rust / Tauri build output
/target/
/src-tauri/target/
/src-tauri/target-*/
/src-tauri/permissions/autogenerated/

