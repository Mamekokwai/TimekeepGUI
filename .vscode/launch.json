{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/sample/timekeep/cmd/cli",
      "cwd": "${workspaceFolder}/sample/timekeep",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "Debug Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/sample/timekeep/cmd/service",
      "args": [
        "--debug"
      ],
      "cwd": "${workspaceFolder}/sample/timekeep",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "Debug CLI Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/sample/timekeep/cmd/cli",
      "cwd": "${workspaceFolder}/sample/timekeep",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "TimekeepGUI: Vite Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "TimekeepGUI: Tauri Dev",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run tauri -- dev",
      "cwd": "${workspaceFolder}"
    }
  ]
}
