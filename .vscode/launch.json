{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug CLI",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "Debug Service",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/service",
      "args": [
        "--debug"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "0"
      }
    },
    {
      "name": "Debug CLI Tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}/cmd/cli",
      "cwd": "${workspaceFolder}",
      "env": {
        "CGO_ENABLED": "0"
      }
    }
  ]
}
