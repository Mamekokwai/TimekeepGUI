{
  "go.goroot": "C:\\Program Files\\Go",
  "go.useLanguageServer": true,
  "go.toolsManagement.autoUpdate": true,
  "go.formatTool": "gofmt",
  "go.lintTool": "staticcheck",
  "go.lintOnSave": "package",
  "terminal.integrated.env.windows": {
    "PATH": "${env:PATH};${config:go.goroot}\\bin;${env:USERPROFILE}\\.cargo\\bin"
  },
  "go.testTimeout": "10m",
  "go.testFlags": [
    "-v"
  ],
  "go.testEnvVars": {
    "CGO_ENABLED": "0"
  },
  "eslint.workingDirectories": [
    {
      "directory": "${workspaceFolder}",
      "mode": "location"
    }
  ],
  "eslint.validate": [
    "javascript",
    "typescript",
    "typescriptreact"
  ],
  "typescript.tsdk": "${workspaceFolder}/node_modules/typescript/lib",
  "rust-analyzer.linkedProjects": [
    "${workspaceFolder}/src-tauri/Cargo.toml"
  ],
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.cargo.buildScripts.enable": true,
  "rust-analyzer.procMacro.enable": true,
  "[go]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.organizeImports": "explicit"
    }
  },
  "[go.mod]": {
    "editor.defaultFormatter": "golang.go",
    "editor.formatOnSave": true
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml",
    "editor.formatOnSave": true
  },
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    }
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "files.exclude": {
    "**/*.exe": true,
    "**/*.test": true
  },
  "search.exclude": {
    "**/internal/database/*.sql.go": true,
    "**/node_modules": true,
    "**/src-tauri/target": true
  },
  "files.watcherExclude": {
    "**/node_modules/**": true,
    "**/src-tauri/target/**": true
  },
