{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Go: Test all packages",
      "type": "shell",
      "command": "go test ./... -cover",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": [
        "$go-test"
      ]
    },
    {
      "label": "Go: Format",
      "type": "shell",
      "command": "gofmt -w .",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "problemMatcher": []
    },
    {
      "label": "Go: Staticcheck",
      "type": "shell",
      "command": "staticcheck ./...",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "problemMatcher": []
    },
    {
      "label": "SQLC: Generate",
      "type": "shell",
      "command": "sqlc generate",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "problemMatcher": []
    },
    {
      "label": "Build: CLI",
      "type": "shell",
      "command": "go build -o timekeep.exe ./cmd/cli",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "problemMatcher": [
        "$go"
      ],
      "group": "build"
    },
    {
      "label": "Build: Service",
      "type": "shell",
      "command": "go build -o timekeep-service.exe ./cmd/service",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "problemMatcher": [
        "$go"
      ],
      "group": "build"
    },
    {
      "label": "Timekeep: Service Dev",
      "type": "shell",
      "command": "go run ./cmd/service --debug",
      "options": {
        "cwd": "${workspaceFolder}/sample/timekeep"
      },
      "problemMatcher": []
    },
    {
      "label": "Patina: Install dependencies",
      "type": "shell",
      "command": "npm ci",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Patina: Dev (Vite)",
      "type": "shell",
      "command": "npm run dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Patina: Tauri Dev",
      "type": "shell",
      "command": "npm run tauri -- dev",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Patina: Tauri Dev + Timekeep Service",
      "dependsOrder": "parallel",
      "dependsOn": [
        "Timekeep: Service Dev",
        "Patina: Tauri Dev"
      ],
      "problemMatcher": []
    },
    {
      "label": "Patina: Typecheck",
      "type": "shell",
      "command": "npm run check:types",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Patina: Lint",
      "type": "shell",
      "command": "npm run check:lint",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "Patina: Test",
      "type": "shell",
      "command": "npm test",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "Patina: Build",
      "type": "shell",
      "command": "npm run build",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$tsc"
      ],
      "group": "build"
    },
    {
      "label": "Patina: Browser Smoke",
      "type": "shell",
      "command": "npm run test:ui-browser-smoke",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": false
      }
    },
    {
      "label": "CI: Check style",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Go: Staticcheck",
        "Go: Test all packages"
      ],
      "problemMatcher": []
    }
  ]
}
